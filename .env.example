# Live chat. If OPENAI_API_KEY is empty, the widget shows a WhatsApp message instead of an error.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Used only when OPENAI_API_KEY is not set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional enquiry storage. POST JSON to this URL. If empty, the form hands the visitor to WhatsApp.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
