# Live chat. If OPENAI_API_KEY is empty, the widget shows a WhatsApp message instead of an error.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Used only when OPENAI_API_KEY is not set.
# A flash-lite id is tried first. Leave blank to use the fastest listed flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Durable lead storage. Set ONE of these pairs. The daily export reads Redis or Postgres only.
# Upstash Redis, including the Vercel KV / Upstash integration:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The same integration may use these names instead:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or Vercel Postgres. The leads table is created on the first saved enquiry.
POSTGRES_URL=

# Protects GET /api/leads?since=ISO. Send Authorization: Bearer <token>.
LEADS_TOKEN=

# Optional. Used only when Redis and Postgres are both unset. This does not feed GET /api/leads.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
